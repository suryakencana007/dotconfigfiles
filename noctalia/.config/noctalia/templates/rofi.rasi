/* TEMPLATE Noctalia -> ~/.config/rofi/noctalia.rasi. Warna Material 3 dari palet wallpaper. */
* {
  bg:          {{ colors.surface.default.rgba | set_alpha 0.94 }};
  bg-alt:      {{ colors.on_surface.default.rgba | set_alpha 0.05 }};   /* kotak input samar */
  fg:          {{ colors.on_surface.default.hex }};
  fg-dim:      {{ colors.on_surface_variant.default.hex }};
  accent:      {{ colors.primary.default.hex }};
  border:      {{ colors.outline_variant.default.rgba | set_alpha 0.5 }};
  selected-bg: {{ colors.on_surface.default.rgba | set_alpha 0.08 }};   /* ala Omarchy: selected-background-alpha 0.08 */
  selected-fg: {{ colors.primary.default.hex }};                         /* teks terpilih = warna aksen */
  urgent:      {{ colors.error.default.hex }};
}
