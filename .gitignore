# file hasil render Noctalia (dibuat ulang otomatis dari wallpaper)
nvim/.config/nvim/lua/noctalia.lua
alacritty/.config/alacritty/themes/
# plugin manager
tmux/.config/tmux/plugins/
# backup
*.bak
*.bak.*

# file render template Hyprland milik Noctalia (sejak hypr di-stow --no-folding, file ini di ~/.config/hypr, bukan repo)
hypr/.config/hypr/noctalia.lua

# file render template rofi milik Noctalia
rofi/.config/rofi/noctalia.rasi

# file render template gtk milik Noctalia (gtk di-stow --no-folding, jadi ada di ~/.config/gtk-*/, bukan repo)
gtk/.config/gtk-3.0/gtk.css
gtk/.config/gtk-3.0/noctalia.css
gtk/.config/gtk-4.0/gtk.css
gtk/.config/gtk-4.0/noctalia.css

# bytecode python (mis. dari py_compile saat uji)
__pycache__/

# lazy.nvim menulis ulang file ini di tiap mesin (versi plugin lokal); tidak dilacak supaya tidak bentrok antar mesin
nvim/.config/nvim/lazy-lock.json
resi/iso/work/
resi/iso/out/
resi/iso/cache/
