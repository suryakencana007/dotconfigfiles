# Tema Plymouth "Resi Arch" (modul script). Aset dibuat resi/boot/make-assets.sh, dirender 2x untuk layar 1080p.
# Tata letak: wordmark di tengah, bilah progres tipis di bawahnya; saat LUKS meminta passphrase bilah diganti kotak isian.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
scale = screen_h / 1080 / 2;              # faktor untuk aset 2x
if (scale < 0.3) scale = 0.3;

fun scaled(image, factor) {
  return image.Scale(Math.Int(image.GetWidth() * factor), Math.Int(image.GetHeight() * factor));
}

# ---- wordmark ----
logo.image = scaled(Image("logo.png"), scale);
logo.sprite = Sprite(logo.image);
logo.x = screen_x + Math.Int((screen_w - logo.image.GetWidth()) / 2);
logo.y = screen_y + Math.Int(screen_h * 0.44 - logo.image.GetHeight() / 2);
logo.sprite.SetPosition(logo.x, logo.y, 10);
below_logo = logo.y + logo.image.GetHeight();

# ---- bilah progres ----
bar.w = Math.Int(480 * scale);
bar.h = Math.Int(8 * scale);
if (bar.h < 2) bar.h = 2;
bar.x = screen_x + Math.Int((screen_w - bar.w) / 2);
bar.y = below_logo + Math.Int(110 * scale);
bar.box_image = Image("progress_box.png").Scale(bar.w, bar.h);
bar.box = Sprite(bar.box_image);
bar.box.SetPosition(bar.x, bar.y, 5);
bar.fill_source = Image("progress_bar.png");
bar.fill = Sprite();
bar.fill.SetPosition(bar.x, bar.y, 6);
bar.fill_w = 0;
bar.real = 0;                              # progres dari plymouthd (perkiraan dari lama boot sebelumnya)
bar.frame = 0;                             # progres berbasis waktu supaya bilah tetap bergerak di boot pertama

fun draw_bar() {
  t = bar.frame / 200;                     # ~4 detik pada 50 fps
  if (t > 1) t = 1;
  eased = (1 - (1 - t) * (1 - t) * (1 - t)) * 0.92;
  p = bar.real;
  if (eased > p) p = eased;
  w = Math.Int(bar.w * p);
  if (w < 1) w = 1;
  if (w != bar.fill_w) {
    bar.fill_w = w;
    bar.fill.SetImage(bar.fill_source.Scale(w, bar.h));
  }
}

fun refresh_callback() {
  bar.frame++;
  if (Plymouth.GetMode() == "boot") draw_bar();
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
  bar.real = progress;
}
Plymouth.SetBootProgressFunction(progress_callback);

fun show_bar(visible) {
  bar.box.SetOpacity(visible);
  bar.fill.SetOpacity(visible);
}
# Mati/reboot/pembaruan: hanya wordmark
if (Plymouth.GetMode() != "boot") show_bar(0);

# ---- passphrase disk (LUKS) ----
prompt.image = scaled(Image("prompt.png"), scale);
prompt.sprite = Sprite(prompt.image);
prompt.sprite.SetPosition(screen_x + Math.Int((screen_w - prompt.image.GetWidth()) / 2), below_logo + Math.Int(80 * scale), 5);
prompt.sprite.SetOpacity(0);

entry.image = scaled(Image("entry.png"), scale);
entry.sprite = Sprite(entry.image);
entry.x = screen_x + Math.Int((screen_w - entry.image.GetWidth()) / 2);
entry.y = below_logo + Math.Int(150 * scale);
entry.sprite.SetPosition(entry.x, entry.y, 5);
entry.sprite.SetOpacity(0);

bullet.image = scaled(Image("bullet.png"), scale);
bullet.step = bullet.image.GetWidth() + Math.Int(10 * scale);
bullet.max = Math.Int((entry.image.GetWidth() - 40 * scale) / bullet.step);
bullet.count = 0;

fun display_password_callback(text, bullets) {
  show_bar(0);
  prompt.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);
  shown = bullets;
  if (shown > bullet.max) shown = bullet.max;
  for (index = bullet.count; index < shown; index++) {       # sprite dibuat sekali, lalu hanya ditampilkan/disembunyikan
    bullet.sprites[index] = Sprite(bullet.image);
    bullet.count = index + 1;
  }
  start_x = entry.x + Math.Int((entry.image.GetWidth() - shown * bullet.step) / 2);
  for (index = 0; index < bullet.count; index++) {
    if (index < shown) {
      bullet.sprites[index].SetPosition(start_x + index * bullet.step, entry.y + Math.Int((entry.image.GetHeight() - bullet.image.GetHeight()) / 2), 6);
      bullet.sprites[index].SetOpacity(1);
    } else {
      bullet.sprites[index].SetOpacity(0);
    }
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  prompt.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);
  for (index = 0; index < bullet.count; index++) bullet.sprites[index].SetOpacity(0);
  if (Plymouth.GetMode() == "boot") show_bar(1);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
