#!/usr/bin/env bash
# Pasca-archinstall (dipanggil resi-iso-install per tahap, supaya papan tahapan bisa menampilkannya terpisah):
#   prepare  target dipasang ulang di /mnt bila perlu, repo dotfiles disalin ke home user, snapper untuk /,
#            mirror offline di-bind ke target + pacman.conf target hanya repo lokal
#   install  `resi-shell install --chroot [--offline]` sebagai user dengan sudo tanpa password sementara
#   finish   sudoers sementara dihapus, pacman.conf bersih dikembalikan, log disalin, target dilepas
# Tanpa argumen tahap: ketiganya berurutan (dipakai bila dipanggil manual).
set -euo pipefail
STATE="${1:-/root/resi}"; PHASE="${2:-all}"; MNT=/mnt; RESI_SHARE=/usr/share/resi-shell
# shellcheck disable=SC1091
source "$STATE/answers"
# jawaban wizard: disk username encrypt git_name git_email offline (datang dari file, bukan dari script ini)
disk="${disk:?}"; username="${username:?}"; encrypt="${encrypt:-0}"; git_name="${git_name:-}"; git_email="${git_email:-}"
offline="${offline:-0}"; home="/home/$username"

info() { printf '\e[1;32m  › %s\e[0m\n' "$*"; }

# archinstall biasanya meninggalkan target terpasang di /mnt; kalau tidak (mis. tahap dijalankan ulang), pasang ulang.
mount_target() {
  mountpoint -q "$MNT" && return 0
  part() { if [[ $disk == *nvme* || $disk == *mmcblk* ]]; then echo "${disk}p$1"; else echo "${disk}$1"; fi; }
  local root_dev; root_dev=$(part 2)
  if (( encrypt )); then
    cryptsetup status resi_root >/dev/null 2>&1 || jq -r .encryption_password "$STATE/user_credentials.json" | cryptsetup open "$root_dev" resi_root -
    root_dev=/dev/mapper/resi_root
  fi
  mount -o noatime,compress=zstd,subvol=@ "$root_dev" "$MNT"
  mkdir -p "$MNT/home" "$MNT/var/log" "$MNT/var/cache/pacman/pkg" "$MNT/boot"
  mount -o noatime,compress=zstd,subvol=@home "$root_dev" "$MNT/home"
  mount -o noatime,compress=zstd,subvol=@log "$root_dev" "$MNT/var/log"
  mount -o noatime,compress=zstd,subvol=@pkg "$root_dev" "$MNT/var/cache/pacman/pkg"
  mount "$(part 1)" "$MNT/boot"
}

phase_prepare() {
  mount_target
  [[ -d "$MNT$home" ]] || { echo "user home not found: $MNT$home" >&2; exit 1; }

  info "copying the dotfiles repo to $home/dotconfigfiles"
  rm -rf "$MNT$home/dotconfigfiles"; tar -xf "$RESI_SHARE/dotconfigfiles.tar" -C "$MNT$home"
  arch-chroot "$MNT" chown -R "$username:$username" "$home"     # SEBELUM git init: tar mengekstrak sebagai root, user tidak bisa membuat .git
  # jadikan repo git supaya resi-shell update (git pull) bekerja
  arch-chroot "$MNT" runuser -u "$username" -- bash -c "cd $home/dotconfigfiles && git init -q -b main && git remote add origin https://github.com/suryakencana007/dotconfigfiles.git && git add -A && git -c user.name=resi -c user.email=resi@localhost commit -q -m 'Installed from ISO' && git fetch -q origin main && git reset -q --soft origin/main && git branch -q --set-upstream-to=origin/main main" \
    || echo "  (could not link the repo to GitHub now; resi-shell update will need: git fetch && git reset --hard origin/main)"

  info "snapper: snapshots of / (Btrfs)"
  arch-chroot "$MNT" bash -c 'snapper --no-dbus -c root create-config / 2>/dev/null || true; systemctl enable snapper-timeline.timer snapper-cleanup.timer >/dev/null 2>&1 || true'

  # Mirror offline: bind-mount /usr/share/resi-shell (repo + vendor) ke target; selama chroot, pacman.conf target HANYA
  # repo lokal (db core/extra tidak ada di target tanpa jaringan). finish mengembalikan pacman.conf bersih.
  if (( offline )); then
    info "offline mirror: binding $RESI_SHARE into the target"
    mkdir -p "$MNT$RESI_SHARE"; mountpoint -q "$MNT$RESI_SHARE" || mount --bind "$RESI_SHARE" "$MNT$RESI_SHARE"
    printf '[options]\nArchitecture = auto\nHoldPkg = pacman glibc\nCheckSpace\nParallelDownloads = 8\nSigLevel = Required DatabaseOptional\nLocalFileSigLevel = Optional\n\n[resi-offline]\nSigLevel = Optional TrustAll\nServer = file://%s/repo\n' "$RESI_SHARE" >"$MNT/etc/pacman.conf"
    arch-chroot "$MNT" pacman -Sy >/dev/null 2>&1 || true
  fi
  # sudo tanpa password selama instalasi. NOPASSWD saja tidak cukup: archinstall sudah menulis "<user> ALL=(ALL) ALL", dan
  # `sudo -v` (verifypw=all) tetap meminta password bila ada satu entri tanpa NOPASSWD → prompt tersembunyi di balik papan
  # tahapan lalu timeout. `!authenticate` mematikan autentikasi untuk user ini sampai drop-in dihapus di tahap finish.
  printf 'Defaults:%s !authenticate\n%s ALL=(ALL) NOPASSWD: ALL\n' "$username" "$username" >"$MNT/etc/sudoers.d/99-resi-install"; chmod 440 "$MNT/etc/sudoers.d/99-resi-install"
  cp -L /etc/resolv.conf "$MNT/etc/resolv.conf" 2>/dev/null || true
}

phase_install() {
  mount_target
  local extra=(); (( offline )) && extra=(--offline)
  info "running resi-shell install --chroot ${extra[*]} as $username"
  arch-chroot "$MNT" runuser -u "$username" -- env HOME="$home" USER="$username" RESI_GIT_NAME="$git_name" RESI_GIT_EMAIL="$git_email" RESI_VENDOR="$RESI_SHARE/vendor" \
    bash "$home/dotconfigfiles/install.sh" install --chroot "${extra[@]}"
}

phase_finish() {
  mount_target
  rm -f "$MNT/etc/sudoers.d/99-resi-install"
  if (( offline )); then
    umount "$MNT$RESI_SHARE" 2>/dev/null || true; rmdir "$MNT$RESI_SHARE" 2>/dev/null || true
    install -m644 "$RESI_SHARE/pacman.conf.clean" "$MNT/etc/pacman.conf"        # kembali ke repo Arch biasa
    rm -f "$MNT/var/lib/pacman/sync/resi-offline.db"
    info "target pacman.conf restored (Arch mirrors); first 'resi-shell update' with internet fetches nvim/tmux plugins"
  fi
  # log installer ikut ke sistem baru (ISO live hilang setelah reboot)
  cp /root/resi-install.log "$MNT/var/log/resi-install.log" 2>/dev/null || true
  info "unmounting"
  umount -R "$MNT" || true
  (( encrypt )) && cryptsetup close resi_root 2>/dev/null || true
}

case "$PHASE" in
  prepare|install|finish) "phase_$PHASE" ;;
  all) phase_prepare; rc=0; phase_install || rc=$?; phase_finish; (( rc == 0 )) || { echo "resi-shell install --chroot exited with $rc" >&2; exit "$rc"; } ;;
  *) echo "usage: resi-iso-postinstall <state dir> [prepare|install|finish]" >&2; exit 2 ;;
esac
