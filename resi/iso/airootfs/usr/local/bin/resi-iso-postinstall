#!/usr/bin/env bash
# Pasca-archinstall (dipanggil resi-iso-install): target dipasang ulang di /mnt bila perlu, repo dotfiles disalin ke
# home user, snapper untuk /, lalu `resi-shell install --chroot` sebagai user dengan sudo tanpa password sementara.
set -euo pipefail
STATE="${1:-/root/resi}"; MNT=/mnt; RESI_SHARE=/usr/share/resi-shell
# shellcheck disable=SC1091
source "$STATE/answers"        # disk username encrypt git_name git_email

info() { printf '\e[1;32m  › %s\e[0m\n' "$*"; }

# archinstall biasanya meninggalkan target terpasang di /mnt; kalau tidak, pasang ulang.
if ! mountpoint -q "$MNT"; then
  part() { if [[ $disk == *nvme* || $disk == *mmcblk* ]]; then echo "${disk}p$1"; else echo "${disk}$1"; fi; }
  root_dev=$(part 2)
  if (( encrypt )); then
    cryptsetup status resi_root >/dev/null 2>&1 || jq -r .encryption_password "$STATE/user_credentials.json" | cryptsetup open "$root_dev" resi_root -
    root_dev=/dev/mapper/resi_root
  fi
  mount -o noatime,compress=zstd,subvol=@ "$root_dev" "$MNT"
  mkdir -p "$MNT/home" "$MNT/var/log" "$MNT/var/cache/pacman/pkg" "$MNT/boot"
  mount -o noatime,compress=zstd,subvol=@home "$root_dev" "$MNT/home"
  mount -o noatime,compress=zstd,subvol=@log "$root_dev" "$MNT/var/log"
  mount -o noatime,compress=zstd,subvol=@pkg "$root_dev" "$MNT/var/cache/pacman/pkg"
  mount "$(part 1)" "$MNT/boot"
fi

home="/home/$username"
[[ -d "$MNT$home" ]] || { echo "user home not found: $MNT$home" >&2; exit 1; }

info "copying the dotfiles repo to $home/dotconfigfiles"
rm -rf "$MNT$home/dotconfigfiles"; tar -xf "$RESI_SHARE/dotconfigfiles.tar" -C "$MNT$home"
# jadikan repo git supaya resi-shell update (git pull) bekerja
arch-chroot "$MNT" runuser -u "$username" -- bash -c "cd $home/dotconfigfiles && git init -q -b main && git remote add origin https://github.com/suryakencana007/dotconfigfiles.git && git add -A && git -c user.name=resi -c user.email=resi@localhost commit -q -m 'Installed from ISO' && git fetch -q origin main && git reset -q --soft origin/main && git branch -q --set-upstream-to=origin/main main" \
  || echo "  (could not link the repo to GitHub now; resi-shell update will need: git fetch && git reset --hard origin/main)"
arch-chroot "$MNT" chown -R "$username:$username" "$home"

info "snapper: snapshots of / (Btrfs)"
arch-chroot "$MNT" bash -c 'snapper --no-dbus -c root create-config / 2>/dev/null || true; systemctl enable snapper-timeline.timer snapper-cleanup.timer >/dev/null 2>&1 || true'

info "running resi-shell install --chroot as $username"
echo "$username ALL=(ALL) NOPASSWD: ALL" >"$MNT/etc/sudoers.d/99-resi-install"; chmod 440 "$MNT/etc/sudoers.d/99-resi-install"
cp -L /etc/resolv.conf "$MNT/etc/resolv.conf" 2>/dev/null || true
set +e
arch-chroot "$MNT" runuser -u "$username" -- env HOME="$home" USER="$username" RESI_GIT_NAME="$git_name" RESI_GIT_EMAIL="$git_email" \
  bash "$home/dotconfigfiles/install.sh" install --chroot
rc=$?
set -e
rm -f "$MNT/etc/sudoers.d/99-resi-install"
(( rc == 0 )) || { echo "resi-shell install --chroot exited with $rc" >&2; exit $rc; }

info "unmounting"
umount -R "$MNT" || true
(( encrypt )) && cryptsetup close resi_root 2>/dev/null || true
