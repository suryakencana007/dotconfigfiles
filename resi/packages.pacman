# Paket repo resmi Arch untuk resi-shell. Satu per baris, "#" komentar. Diinstal dengan pacman -S --needed.
# --- dasar & alat ---
base-devel
git
stow
pacman-contrib
openssh
sudo
man-db
man-pages
zram-generator
# linter skrip shell (resi-shell doctor memeriksa bin/ dan install.sh)
shellcheck
# --- shell & terminal ---
zsh
zsh-autosuggestions
zsh-syntax-highlighting
zsh-completions
alacritty
tmux
neovim
lua
eza
bat
fd
fzf
ripgrep
zoxide
git-delta
dust
duf
btop
tealdeer
lazygit
jq
fastfetch
mpv
yt-dlp
7zip
# --- theme carousel (hypr-theme-carousel: GTK4 + libadwaita + thumbnail vips) ---
python-gobject
gtk4
libadwaita
libvips
# --- font ---
# font utama: terminal, Noctalia, rofi, mpv, groupbar Hyprland, greeter
ttf-jetbrains-mono-nerd
ttf-dejavu
ttf-liberation
noto-fonts
noto-fonts-cjk
noto-fonts-emoji
# --- desktop: Hyprland + Noctalia + rofi ---
# keyring (Secret Service): password Brave, Noctalia secret-store; dibuka otomatis saat login lewat PAM greetd
gnome-keyring
hyprland
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
adw-gtk-theme
papirus-icon-theme
noctalia
rofi
hyprshot
satty
hyprpicker
grim
slurp
wl-clipboard
libxkbcommon
polkit
brightnessctl
power-profiles-daemon
upower
greetd
# boot splash "Resi Arch" (tema di resi/boot/plymouth/resi, dipasang resi/boot/setup-boot-splash.sh)
plymouth
# lock screen (hypr-lock -> hyprlock; hypridle hanya kait loginctl lock-session + kunci sebelum suspend)
hyprlock
hypridle
# widget "now playing" di lock screen (hypr-lock --media)
playerctl
# --- file manager & mount ---
thunar
thunar-volman
gvfs
udiskie
exfatprogs
# --- audio & jaringan ---
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber
# tema suara untuk efek suara Noctalia 5.2+ (notifikasi, volume, colok/cabut charger, screenshot);
# tanpa ini log mencatat "sound theme 'freedesktop' is missing sound" dan tidak ada yang berbunyi
sound-theme-freedesktop
gst-plugin-pipewire
networkmanager
bluez
bluez-utils
sof-firmware
