#!/usr/bin/env bash
# Indikator update paket di bar Noctalia (ala widget SystemUpdate Omarchy): cek repo + AUR, tampilkan tombol
# "N" di bar bila ada update (klik = resi-shell update), notifikasi saat jumlahnya bertambah.
#   hypr-updates check    cek sekarang, perbarui indikator (dipanggil watch, dan resi-shell update selesai)
#   hypr-updates list     cetak daftar update yang tersimpan dari cek terakhir
#   hypr-updates watch    jalan terus (autostart.lua): cek 1 menit setelah mulai, lalu tiap 6 jam
#   hypr-updates clear    hapus indikator
# Uji: HYPR_UPDATES_FAKE=3 hypr-updates check  (pura-pura ada 3 update).
set -uo pipefail

CACHE_DIR="$HOME/.cache/resi"; LIST="$CACHE_DIR/updates.txt"; COUNT="$CACHE_DIR/updates.count"
INDICATOR="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/zy-updates.toml"   # "zy" < "zz-recording": REC (sementara) menang
INTERVAL=$(( 6 * 3600 ))

notify() { command -v noctalia >/dev/null && noctalia msg notification-show "$1" "$2" >/dev/null 2>&1 || true; }

repo_updates() { # checkupdates (pacman-contrib) menyegarkan db sementara tanpa root; fallback pacman -Qu (db lokal, bisa basi)
  if command -v checkupdates >/dev/null; then checkupdates --nocolor 2>/dev/null; else pacman -Qu 2>/dev/null; fi
}
aur_updates() { command -v yay >/dev/null && timeout 120 yay -Qua 2>/dev/null | grep -v '^\s*::' ; true; }

indicator_on() {
  local n="$1" lane
  lane="$(noctalia config export 2>/dev/null | awk '/^\[bar\.default\]/{f=1} f && /^end = /{print; exit}')"
  [[ -z $lane ]] && lane='end = []'
  [[ $lane == *'"updates"'* ]] || lane="${lane/end = [/end = [ \"updates\",}"
  cat >"$INDICATOR" <<TOML
# GENERATED by hypr-updates when package updates are available; removed after resi-shell update.
[bar.default]
$lane

[widget.updates]
type    = "custom_button"
glyph   = "package"
label   = "$n"
tooltip = "$n package update(s) available. Click to run resi-shell update."
color   = "primary"

[widget.updates.actions]
left   = "exec $HOME/.local/bin/hypr-tui $HOME/.local/bin/resi-shell update"
right  = "exec $HOME/.local/bin/hypr-tui $HOME/.local/bin/hypr-updates list"
TOML
  noctalia msg config-reload >/dev/null 2>&1 || true
}
indicator_off() { [[ -f $INDICATOR ]] && { rm -f "$INDICATOR"; noctalia msg config-reload >/dev/null 2>&1 || true; }; }

check() {
  mkdir -p "$CACHE_DIR"
  local prev=0 list n; [[ -f $COUNT ]] && prev=$(<"$COUNT")
  if [[ -n ${HYPR_UPDATES_FAKE:-} ]]; then list=$(seq 1 "$HYPR_UPDATES_FAKE" | sed 's/^/fake-package-/'); else list=$( { repo_updates; aur_updates; } | grep -v '^$' | sort -u); fi
  n=0; [[ -n $list ]] && n=$(printf '%s\n' "$list" | wc -l)
  printf '%s\n' "$list" >"$LIST"; echo "$n" >"$COUNT"; date +%s >"$CACHE_DIR/updates.checked"
  if (( n > 0 )); then
    indicator_on "$n"
    (( n > prev )) && notify "Updates available" "$n package update(s). Click the bar icon or run: resi-shell update"
  else
    indicator_off
  fi
  echo "$n update(s) available"
}

case "${1:-check}" in
  check) check ;;
  list)  printf '\e[32mPending package updates\e[0m\n\n'
         if [[ -f $COUNT && $(<"$COUNT") -gt 0 ]]; then command cat "$LIST"; else echo "(none, or not checked yet)"; fi
         [[ -f $CACHE_DIR/updates.checked ]] && echo && echo "Last checked: $(date -d @"$(<"$CACHE_DIR/updates.checked")" '+%F %H:%M')" ;;
  clear) indicator_off; echo 0 >"$COUNT" 2>/dev/null || true ;;
  watch) mkdir -p "$CACHE_DIR"; exec 9>"$CACHE_DIR/updates.lock"; flock -n 9 || exit 0
         sleep 60; while true; do check >/dev/null 2>&1; sleep "$INTERVAL"; done ;;
  *) echo "usage: hypr-updates check|list|watch|clear" >&2; exit 2 ;;
esac
