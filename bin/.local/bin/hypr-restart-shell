#!/usr/bin/env bash
# Restart shell desktop (Noctalia), ala omarchy-restart-shell. Dipanggil dari hypr-menu > Update > Process > Shell.
# Menolak saat sesi terkunci: mematikan klien lock membuat sesi terkunci tanpa jalan masuk (failsafe Hyprland).
# Noctalia dijalankan ulang lewat Hyprland (exec_cmd) supaya mewarisi environment sesi, bukan environment terminal.
set -uo pipefail

printf '\e[32mRestart Noctalia shell\e[0m\n\n'

if "$HOME/.local/bin/hypr-lock" --status || [[ $(noctalia msg status 2>/dev/null | jq -r '.locked // false') == true ]]; then
  echo "Refusing to restart the shell while the session is locked." >&2; exit 1
fi

pid=$(pgrep -o -f -x '(/usr/bin/)?noctalia( -d| --daemon)?' || true)
if [[ -n $pid ]]; then
  echo "Stopping noctalia (pid $pid)..."
  kill "$pid" 2>/dev/null
  for _ in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  kill -0 "$pid" 2>/dev/null && { echo "Still running, killing it."; kill -9 "$pid"; sleep 0.3; }
else
  echo "noctalia is not running; starting it."
fi

hyprctl dispatch 'hl.dsp.exec_cmd("noctalia")' >/dev/null
for _ in $(seq 1 100); do
  noctalia msg status >/dev/null 2>&1 && { echo "Noctalia is back."; exit 0; }
  sleep 0.1
done
echo "Noctalia did not become ready after restart." >&2; exit 1
