#!/usr/bin/env bash
# Buka/tutup rofi dengan satu tombol. Pakai:  rofi-toggle apps   (rofi -show drun)
#                                            rofi-toggle menu   (hypr-menu)
#                                            rofi-toggle theme  (hypr-theme: wallpaper/palet/mode)
# Kalau rofi sedang tampil (dari mode apa pun), tombol yang sama menutupnya.
set -uo pipefail
if pgrep -x rofi >/dev/null; then
  pkill -x rofi
  exit 0
fi
case "${1:-apps}" in
  apps) exec rofi -show drun ;;
  menu) exec "$HOME/.local/bin/hypr-menu" ;;
  theme) exec "$HOME/.local/bin/hypr-theme" ;;
  *)    echo "pakai: rofi-toggle apps|menu|theme" >&2; exit 2 ;;
esac
