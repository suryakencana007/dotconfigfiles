#!/usr/bin/env bash
# resi-shell: pembungkus installer dotfiles. Sama dengan ~/dotconfigfiles/install.sh.
#   resi-shell install [--dry-run]   pasang & setel semuanya (idempotent, aman diulang)
#   resi-shell update [-y]           konfirmasi, git pull, stow ulang, paket baru, plugin (-y: tanpa tanya)
#   resi-shell doctor                cek kondisi (stow, config, program)
#   resi-shell packages              tampilkan daftar paket
REPO="${RESI_REPO:-$HOME/dotconfigfiles}"
[ -x "$REPO/install.sh" ] || { echo "repo not found at $REPO (set RESI_REPO)" >&2; exit 1; }
exec "$REPO/install.sh" "$@"
