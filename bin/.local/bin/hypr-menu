#!/usr/bin/env bash
# Menu bertingkat ala omarchy-menu, ditampilkan lewat rofi (dmenu). Super+Alt+Space.
# Tiap entri: "glyph  Label"; entri submenu diberi 󰅂 di kanan. Esc menutup; "Back" atau BackSpace (saat filter kosong) kembali ke menu induk.
# Uji tanpa GUI:  HYPR_MENU_TEST=1 hypr-menu   (memilih entri pertama tiap level dan mencetak aksinya)
set -uo pipefail

KEYBINDINGS="$HOME/.local/bin/hypr-keybindings"
BACK="󰁍  Back"
# Lebar jendela menu (lebih sempit dari launcher di layout.rasi, 560px) dan posisi tab-stop 󰅂 submenu.
# Lebar teks di dalam baris = lebar - border 2 - padding jendela 28 - padding elemen 24 = lebar - 54.
# Chevron 9px (diukur dengan Pango); tab-stop harus < lebar teks - 9, kalau tidak rofi memotong baris dengan "…".
MENU_WIDTH="${HYPR_MENU_WIDTH:-400}"
CHEVRON_TAB_STOP="$(( MENU_WIDTH - 78 ))px"

menu() { # $1 judul, $2 "back" bila BackSpace boleh berarti kembali. stdin: "label\taksi". Mencetak aksi terpilih.
  local title="$1" back="${2:-}" lines labels choice filter="" out rc
  # Entri yang membuka submenu (aksi "menu:...") diberi 󰅂 yang ditambatkan di tepi kanan: label tampil
  # memakai TAB + chevron dan rofi diberi tab-stop dekat tepi kanan (element-text { tab-stops }).
  local chev; chev=$(printf '\U000F0142')
  lines=$(cat)
  labels=$(printf '%s\n' "$lines" | awk -F'\t' -v chev="$chev" '{ if ($2 ~ /^menu:/) print $1 "\t" chev; else print $1 }')
  if [[ ${HYPR_MENU_TEST:-} == 1 ]]; then
    choice=$(printf '%s\n' "$labels" | head -1); echo "[test] $title -> $choice" >&2
  else
    # BackSpace di submenu: filter kosong = kembali (seperti entri Back); filter terisi = hapus satu huruf.
    # rofi tidak bisa membedakan keduanya, jadi BackSpace dipetakan ke kb-custom-1 (exit 10) dan skrip
    # ini yang memutuskan: kembali, atau buka ulang rofi dengan filter yang dipotong satu huruf.
    local -a keys=()
    [[ $back == back ]] && keys=(-kb-custom-1 BackSpace -kb-remove-char-back "Shift+BackSpace,Control+h")
    while true; do
      # Tanpa -no-custom: saat filter tidak cocok dengan entri mana pun, rofi tetap melaporkan tombol custom
      # (dengan -no-custom ia diam saja, BackSpace jadi mati). Enter pada filter tanpa hasil ditolak di bawah.
      # Pemisah keluaran rofi = US (0x1f), bukan TAB: label submenu sendiri mengandung TAB (sebelum 󰅂).
      out=$(printf '%s\n' "$labels" | rofi -dmenu -i -p "$title" -filter "$filter" -format $'s\x1ff' \
            "${keys[@]}" -theme-str 'configuration { show-icons: false; } window { width: '"$MENU_WIDTH"'px; } element-text { tab-stops: [ '"$CHEVRON_TAB_STOP"' ]; }'); rc=$?
      case $rc in
        0)  choice=${out%%$'\x1f'*}
            if printf '%s\n' "$labels" | grep -qxF -- "$choice"; then break; fi
            filter=${out#*$'\x1f'} ;;                                   # bukan entri (teks bebas): buka lagi
        10) filter=${out#*$'\x1f'}
            [[ -z $filter ]] && { echo back; return 0; }
            filter=${filter%?} ;;
        *)  return 1 ;;
      esac
    done
  fi
  [[ -z $choice ]] && return 1
  choice=${choice%$'\t'"$chev"}                       # buang penanda submenu sebelum dicocokkan
  printf '%s\n' "$lines" | awk -F'\t' -v c="$choice" '$1 == c { print $2; exit }'
}

run_menu() { # $1 judul, $2 nama fungsi yang mencetak entri, $3 fungsi menu induk (opsional)
  local title="$1" items="$2" parent="${3:-}" action
  while true; do
    # Grup harus selalu sukses: dengan pipefail, "[[ -n $parent ]] &&" yang gagal di menu utama
    # akan membuat pipeline dianggap gagal dan menu langsung tertutup.
    action=$( { $items; if [[ -n $parent ]]; then printf '%s\t%s\n' "$BACK" "back"; fi; true; } | menu "$title" "${parent:+back}") || return 0
    case "$action" in
      back) [[ -n $parent ]] && $parent; return 0 ;;
      menu:*) "${action#menu:}"; return 0 ;;
      "") return 0 ;;
      *) [[ ${HYPR_MENU_TEST:-} == 1 ]] && { echo "[test] exec: $action" >&2; return 0; }
         setsid -f sh -c "$action" >/dev/null 2>&1; return 0 ;;
    esac
  done
}

root_items() { cat <<'ITEMS'
󰀻  Apps	rofi -show drun
󰧑  Learn	menu:learn
󱓞  Trigger	menu:trigger
󰔎  Toggle	menu:toggle
󰏘  Style	menu:style
󱁤  Setup	menu:setup
󰣇  Install	menu:install
󰚰  Update	menu:update
󰭌  Remove	menu:remove
󰋽  About	~/.local/bin/hypr-tui fastfetch
󰌢  System	menu:system
ITEMS
}
learn_items() { cat <<ITEMS
󰌌  Keybindings	$KEYBINDINGS --toggle
󰆍  Tmux keybindings	alacritty --class TUI.float -e sh -c 'tmux list-keys -N | less -R'
󰊤  Hyprland wiki	brave https://wiki.hypr.land/
󰨪  Noctalia docs	brave https://docs.noctalia.dev/
ITEMS
}
trigger_items() { cat <<'ITEMS'
󰹑  Screenshot area	noctalia msg screenshot-region
󰖯  Screenshot window	hyprshot -m window -o ~/Pictures/Screenshots
󰍹  Screenshot screen	noctalia msg screenshot-fullscreen
󰑊  Record area (toggle)	~/.local/bin/hypr-record
󰕧  Record screen (toggle)	~/.local/bin/hypr-record screen
󰏘  Color picker	hyprpicker -a
󰅍  Clipboard history	noctalia msg panel-toggle clipboard
󰃭  Calendar	noctalia msg panel-toggle control-center calendar
ITEMS
}
toggle_items() { cat <<'ITEMS'
󱩌  Nightlight	noctalia msg nightlight-toggle
󰅶  Caffeine (no idle lock)	noctalia msg caffeine-toggle
󰂛  Do Not Disturb	noctalia msg notification-dnd-toggle
󰍜  Bar	noctalia msg bar-toggle
󰖩  Wi-Fi	noctalia msg wifi-toggle
󰂯  Bluetooth	noctalia msg bluetooth-toggle
ITEMS
}
style_items() { cat <<'ITEMS'
󰃣  Theme switcher (carousel)	~/.local/bin/hypr-theme-carousel
󰸉  Palette & mode	~/.local/bin/hypr-theme
󰈟  Wallpaper (Noctalia)	noctalia msg panel-toggle wallpaper
󰒞  Random wallpaper	noctalia msg wallpaper-random
󰖔  Dark mode	noctalia msg theme-mode-set dark
󰖨  Light mode	noctalia msg theme-mode-set light
󰒓  Noctalia settings	noctalia msg settings-toggle
ITEMS
}
setup_items() { cat <<'ITEMS'
󰕾  Audio	noctalia msg panel-toggle control-center audio
󰛳  Network	noctalia msg panel-toggle control-center network
󰂯  Bluetooth	noctalia msg panel-toggle control-center bluetooth
󰍹  Display	noctalia msg settings-open display
󰍺  Monitors (nwg-displays)	~/.local/bin/hypr-monitors
󰈮  Hyprland config	alacritty -e nvim ~/.config/hypr/hyprland.lua
󰈙  Noctalia config	alacritty -e nvim ~/.config/noctalia/
󰊢  Dotfiles	alacritty -e sh -c 'cd ~/dotconfigfiles && exec lazygit'
ITEMS
}
install_items() { cat <<'ITEMS'
󰏖  Package	~/.local/bin/hypr-tui --class hypr-pkg-install ~/.local/bin/hypr-pkg-install repo
󰣇  AUR	~/.local/bin/hypr-tui --class hypr-pkg-install ~/.local/bin/hypr-pkg-install aur
󰵮  Development	menu:development
ITEMS
}
# Lingkungan pengembangan (hypr-dev-env, berbasis mise seperti Omarchy). "✓" = sudah terpasang (mise use idempotent).
DEVENV="$HOME/.local/bin/hypr-dev-env"
dev_item() { # $1 glyph, $2 label, $3 env
  local mark=""; "$DEVENV" installed "$3" 2>/dev/null && mark="  ✓"
  printf '%s  %s%s\t%s\n' "$1" "$2" "$mark" "~/.local/bin/hypr-tui $DEVENV install $3"
}
development_items() {
  dev_item "󰫏" "Ruby on Rails" ruby
  printf '%s\t%s\n' "󰌞  JavaScript" "menu:dev_javascript"
  dev_item "󰟣" "Go" go
  printf '%s\t%s\n' "󰌟  PHP" "menu:dev_php"
  dev_item "󰌠" "Python" python
  printf '%s\t%s\n' "󰘧  Elixir" "menu:dev_elixir"
  dev_item "󰅩" "Zig" zig
  dev_item "󱘗" "Rust" rust
  dev_item "󰬷" "Java" java
  dev_item "󰪮" ".NET" dotnet
  dev_item "󰅩" "OCaml" ocaml
  dev_item "󰅩" "Clojure" clojure
  dev_item "󰅩" "Scala" scala
}
dev_javascript_items() { dev_item "󰎙" "Node.js" node; dev_item "󰌞" "Bun" bun; dev_item "󰌞" "Deno" deno; }
dev_php_items()        { dev_item "󰌟" "PHP" php; dev_item "󰌟" "Laravel" laravel; dev_item "󰌟" "Symfony" symfony; }
dev_elixir_items()     { dev_item "󰘧" "Elixir" elixir; dev_item "󰘧" "Phoenix" phoenix; }
# Remove > Development: hanya yang terpasang (ala "when" di Omarchy).
remove_dev_item() { "$DEVENV" installed "$3" 2>/dev/null || return 0; printf '%s  %s\t%s\n' "$1" "$2" "~/.local/bin/hypr-tui $DEVENV remove $3"; }
remove_development_items() {
  local e; for e in ruby node bun deno go php laravel symfony python elixir phoenix zig rust java dotnet ocaml clojure scala; do
    remove_dev_item "󰅩" "$e" "$e"
  done
  "$DEVENV" list >/dev/null 2>&1 || true
}
system_items() {
  printf '%s\t%s\n' "󰌾  Lock" "noctalia msg session lock"
  can_power Suspend   && printf '%s\t%s\n' "󰒲  Suspend" "noctalia msg session suspend"
  can_power Hibernate && printf '%s\t%s\n' "󰤁  Hibernate" "systemctl hibernate"
  cat <<'ITEMS'
󰍃  Logout	noctalia msg session logout
󰜉  Reboot	noctalia msg session reboot
󰐥  Shutdown	noctalia msg session shutdown
ITEMS
}

learn()   { run_menu "Learn"   learn_items   root; }
trigger() { run_menu "Trigger" trigger_items root; }
toggle()  { run_menu "Toggle"  toggle_items  root; }
style()   { run_menu "Style"   style_items   root; }
setup()   { run_menu "Setup"   setup_items   root; }
install() { run_menu "Install" install_items root; }
development()        { run_menu "Development" development_items install; }
dev_javascript()     { run_menu "JavaScript"  dev_javascript_items development; }
dev_php()            { run_menu "PHP"         dev_php_items        development; }
dev_elixir()         { run_menu "Elixir"      dev_elixir_items     development; }
remove_development() { run_menu "Remove"      remove_development_items remove; }
update()  { run_menu "Update"  update_items  root; }
process() { run_menu "Restart" process_items update; }
remove()  { run_menu "Remove"  remove_items  root; }
system()  { run_menu "System"  system_items  root; }
root()    { run_menu "Menu"    root_items; }

root
