#!/usr/bin/env bash
# Pemasang/penghapus paket ala Omarchy (omarchy-pkg-install / omarchy-pkg-aur-install / omarchy-pkg-remove):
# pilih satu atau banyak paket lewat fzf dengan pratinjau info paket, lalu pasang atau hapus.
# Dipanggil dari hypr-menu > Install dan > Remove.
# Pakai:  hypr-pkg-install repo     pasang paket repo resmi (pacman)
#         hypr-pkg-install aur      pasang paket AUR (yay)
#         hypr-pkg-install remove   hapus paket yang terpasang eksplisit (pacman -Rns, beserta dependensi yatim)
#         hypr-pkg-install remove-aur   sama, tetapi daftarnya hanya paket asing/AUR (pacman -Qqm)
# Dari menu dibuka lewat: hypr-tui --class hypr-pkg-install hypr-pkg-install <mode> (jendela mengambang + prompt Done).
# Tombol di fzf: tab = pilih banyak, alt-p = sembunyikan/tampilkan pratinjau, alt-j/k = gulir pratinjau,
#                alt-d/u = gulir setengah halaman, (AUR) alt-b = lihat PKGBUILD, alt-B = kembali ke info.
set -uo pipefail

mode="${1:-repo}"
case "$mode" in repo|aur|remove|remove-aur) ;; *) echo "usage: hypr-pkg-install repo|aur|remove|remove-aur" >&2; exit 2 ;; esac

for dep in fzf pacman; do command -v "$dep" >/dev/null || { echo "$dep is required" >&2; exit 1; }; done
[[ $mode == aur ]] && ! command -v yay >/dev/null && { echo "yay (AUR helper) is required" >&2; exit 1; }

# Minta sudo sekali, lalu jaga kredensialnya tetap hidup selama pemasangan (omarchy-sudo-keepalive).
sudo_keepalive() {
  sudo -v || return 1
  while true; do sudo -n true; sleep 60; done 2>/dev/null &
  trap "kill $! 2>/dev/null" EXIT
}

fzf_args=(
  --multi --layout=reverse --info=inline --color=16 --color='pointer:green,marker:green'
  --preview-label-pos=bottom --preview-window='down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
)
[[ -n ${HYPR_PKG_QUERY:-} ]] && fzf_args+=( --query "$HYPR_PKG_QUERY" )   # pencarian awal (mis. "ttf-" dari Install > Font > Package)

case "$mode" in
  repo)
    fzf_args+=( --prompt='  Install package : ' --preview 'pacman -Sii {1}'
      --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select' )
    pkg_names=$(pacman -Slq | fzf "${fzf_args[@]}")
    [[ -z $pkg_names ]] && exit 0
    sudo_keepalive || exit 1
    echo "$pkg_names" | tr '\n' ' ' | xargs sudo pacman -S --noconfirm
    ;;
  aur)
    fzf_args+=( --prompt='  Install from AUR : ' --preview 'yay -Siia {1}'
      --preview-label='alt-p: toggle description, alt-b: PKGBUILD, alt-j/k: scroll, tab: multi-select'
      --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5'
      --bind 'alt-B:change-preview:yay -Siia {1}' )
    pkg_names=$(yay -Slqa | fzf "${fzf_args[@]}")
    [[ -z $pkg_names ]] && exit 0
    sudo_keepalive || exit 1
    echo "$pkg_names" | sed 's/^/aur\//' | tr '\n' ' ' | xargs yay -S --noconfirm
    code=$?
    command -v updatedb >/dev/null && sudo updatedb >/dev/null 2>&1
    exit $code
    ;;
  remove|remove-aur)
    # Daftar = paket yang dipasang eksplisit (pacman -Qqe), atau hanya paket asing/AUR (pacman -Qqm). Penanda merah.
    if [[ $mode == remove-aur ]]; then list_cmd="pacman -Qqm"; prompt='  Remove AUR package : '; else list_cmd="pacman -Qqe"; prompt='  Remove package : '; fi
    fzf_args+=( --prompt="$prompt" --preview 'pacman -Qi {1}'
      --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
      --color='pointer:red,marker:red' )
    pkg_names=$($list_cmd | fzf "${fzf_args[@]}")
    [[ -z $pkg_names ]] && exit 0
    # Tampilkan semua yang akan ikut terhapus (termasuk dependensi yatim) lalu minta konfirmasi.
    mapfile -t victims < <(echo "$pkg_names" | xargs pacman -Rs -p 2>/dev/null | grep -vE '^(Packages|Total|$)' | sed 's/^/  /')
    (( ${#victims[@]} )) || { echo "Nothing to remove."; exit 1; }
    echo; hypr-tui --box "The following ${#victims[@]} package(s) will be removed (with unused dependencies):" "" "${victims[@]}"; echo
    hypr-tui --confirm "Remove them?" || { echo "Removal cancelled."; exit 1; }
    sudo_keepalive || exit 1
    echo "$pkg_names" | tr '\n' ' ' | xargs sudo pacman -Rns --noconfirm
    ;;
esac
