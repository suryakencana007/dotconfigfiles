[Desktop Entry]
Type=Application
Name=Displays Settings
GenericName=Output configuration utility
Comment=Monitor layout (nwg-displays) with the layout saved outside the dotfiles repo
# Overrides /usr/share/applications/nwg-displays.desktop (same file id): plain `nwg-displays` would write
# ~/.config/hypr/monitors.lua, a stow symlink into ~/dotconfigfiles. hypr-monitors redirects it to nwg-*.
Exec=hypr-monitors
Icon=nwg-displays
Terminal=false
Categories=Settings;DesktopSettings;
